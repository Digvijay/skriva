# Auto detect text files and perform LF normalization
* text=auto

# Go source files always LF
*.go text eol=lf

# Shell scripts always LF
*.sh text eol=lf

# YAML/JSON/TOML
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf

# Markdown and docs
*.md text eol=lf

# Web files
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.mts text eol=lf
*.svg text eol=lf

# Docker
Dockerfile text eol=lf
docker-compose.yml text eol=lf
.dockerignore text eol=lf

# Binary files
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
